{
  "name": "utilities-node",
  "version": "1.0.0",
  "description": "Nova implementação dos meus utilitários de trabalho, originalmente desenvolvidos com HTML, CSS e JavaScript, agora utilizando Node.js, autenticação e práticas modernas de desenvolvimento.",
  "homepage": "https://github.com/jhonatancassante/utilities-node#readme",
  "bugs": {
    "url": "https://github.com/jhonatancassante/utilities-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonatancassante/utilities-node.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "node infra/scripts/dev.js",
    "dev:raw": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "secrets:scan": "ggshield secret scan path -r .",
    "secrets:history": "ggshield secret scan repo .",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "next": "13.1.6",
    "node-pg-migrate": "6.2.2",
    "pg": "8.11.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "dotenv": "17.4.2",
    "dotenv-expand": "11.0.6",
    "husky": "9.1.7",
    "jest": "29.6.2",
    "prettier": "3.9.6"
  }
}
