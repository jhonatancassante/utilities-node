{
  "name": "utilities-node",
  "version": "1.0.0",
  "description": "Nova implementação dos meus utilitários de trabalho, originalmente desenvolvidos com HTML, CSS e JavaScript, agora utilizando Node.js, autenticação e práticas modernas de desenvolvimento.",
  "homepage": "https://github.com/jhonatancassante/utilities-node#readme",
  "bugs": {
    "url": "https://github.com/jhonatancassante/utilities-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonatancassante/utilities-node.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "node infra/scripts/dev.js",
    "dev:raw": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "build": "next build",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint --max-warnings=0 . --ignore-pattern package.json --ignore-pattern package-lock.json",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": [
      "npm run lint:prettier:fix",
      "eslint --max-warnings=0"
    ],
    "!(package|package-lock).json": [
      "npm run lint:prettier:fix"
    ]
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "dedent": "1.7.2",
    "next": "16.2.0",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "8.0.3",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "2.4.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/css": "1.0.0",
    "@eslint/js": "9.39.4",
    "@eslint/json": "1.1.0",
    "@eslint/markdown": "7.5.1",
    "@faker-js/faker": "9.7.0",
    "commitizen": "4.3.2",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.4.5",
    "dotenv-expand": "12.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "set-cookie-parser": "3.1.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
