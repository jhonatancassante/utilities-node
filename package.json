{
  "name": "utilities-node",
  "version": "1.0.0",
  "description": "Nova implementação dos meus utilitários de trabalho, originalmente desenvolvidos com HTML, CSS e JavaScript, agora utilizando Node.js, autenticação e práticas modernas de desenvolvimento.",
  "homepage": "https://github.com/jhonatancassante/utilities-node#readme",
  "bugs": {
    "url": "https://github.com/jhonatancassante/utilities-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonatancassante/utilities-node.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yml up -d",
    "services:stop": "docker compose -f infra/compose.yml stop",
    "services:down": "docker compose -f infra/compose.yml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "prepare": "husky",
    "secrets:scan": "ggshield secret scan path -r .",
    "secrets:history": "ggshield secret scan repo .",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up"
  },
  "dependencies": {
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "dotenv-expand": "^11.0.6",
    "husky": "^9.1.7",
    "jest": "^29.6.2",
    "prettier": "^3.9.6"
  }
}
