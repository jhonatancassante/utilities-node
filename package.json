{
  "name": "utilities-node",
  "version": "1.0.0",
  "description": "Nova implementação dos meus utilitários de trabalho, originalmente desenvolvidos com HTML, CSS e JavaScript, agora utilizando Node.js, autenticação e práticas modernas de desenvolvimento.",
  "homepage": "https://github.com/jhonatancassante/utilities-node#readme",
  "bugs": {
    "url": "https://github.com/jhonatancassante/utilities-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonatancassante/utilities-node.git"
  },
  "license": "MIT",
  "type": "module",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "node infra/scripts/dev.js",
    "dev:raw": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --verbose\"",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --runInBand --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "build": "next build",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint --max-warnings=0 . --ignore-pattern package.json --ignore-pattern package-lock.json",
    "secrets:scan": "ggshield secret scan path -r .",
    "secrets:history": "ggshield secret scan repo .",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": [
      "npm run lint:prettier:fix",
      "eslint --max-warnings=0"
    ],
    "!(package|package-lock).json": [
      "npm run lint:prettier:fix"
    ]
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "2.0.1",
    "dedent": "1.7.2",
    "next": "16.4.0",
    "next-connect": "1.0.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "10.6.0",
    "commitizen": "4.3.2",
    "concurrently": "10.0.6",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "18.0.7",
    "dotenv-expand": "1000.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.11",
    "eslint-plugin-react": "^7.37.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
